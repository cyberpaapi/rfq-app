# Copy to .env and fill in. Never commit your real .env.
OPENAI_API_KEY=sk-your-key-here

# Required to sign in. Create a unique password and store its scrypt hash here.
# Keep the plaintext password only in your private credential manager.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD_HASH=scrypt$32768$8$1$replace-with-generated-salt$replace-with-generated-hash
# Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Keep this stable; changing it makes previously stored account passwords unreadable.
ACCOUNT_PASSWORD_ENCRYPTION_KEY=replace-with-32-byte-base64url-secret

# Models
OPENAI_MODEL=gpt-5.4-mini       # per-page / per-row extraction
OPENAI_CLUB_MODEL=gpt-5.5       # "clubbed view" consolidation pass

# Parallel pipeline tuning (optional)
# AI_CONCURRENCY=4              # chunks processed at once
# AI_PAGES_PER_CALL=1          # PDF pages per request
# AI_ROWS_PER_CALL=10          # spreadsheet rows per request
# AI_MAX_TOKENS=8000

# Server
# PORT=4000

# Optional hosted persistence. Local development keeps server/data/db.json
# unless DATABASE_URL is set. Vercel requires a Neon Postgres connection.
# DATABASE_URL=postgresql://...
# Private Vercel Blob storage for direct 50 MB uploads (required on Vercel).
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
